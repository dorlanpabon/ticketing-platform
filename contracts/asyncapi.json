        "$ref": "#/channels/order-events"
      },
      "messages": [
        {
          "$ref": "#/channels/order-events/messages/ReservationStateChanged"
        }
      ],
      "summary": "Inventory outbox",
      "x-producer": "Inventory outbox"
    },
    "inventory-publish-ready": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/catalog-events"
      },
      "messages": [
        {
          "$ref": "#/channels/catalog-events/messages/InventoryReady"
        }
      ],
      "summary": "Inventory outbox",
      "x-producer": "Inventory outbox"
    },
    "inventory-schedule-expiry": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inventory-expirations"
      },
      "messages": [
        {
          "$ref": "#/channels/inventory-expirations/messages/ExpireReservation"
        }
      ],
      "summary": "Inventory outbox",
      "x-producer": "Inventory outbox"
    },
    "scheduler-request-recovery": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inventory-expirations"
      },
      "messages": [
        {
          "$ref": "#/channels/inventory-expirations/messages/SweepExpiredReservations"
        }
      ],
      "summary": "EventBridge Scheduler or single local recovery emitter",
      "x-producer": "EventBridge Scheduler or single local recovery emitter",
      "x-scheduler": {
        "scheduleExpression": "rate(1 minute)",
        "flexibleWindow": "OFF",
        "maximumEventAgeSeconds": 120,
        "maximumRetryAttempts": 2,
        "deliveryDeadLetterQueue": "<terraform-name>-expiry-scheduler-dlq",
        "messageIdTemplate": "<aws.scheduler.execution-id>",
        "occurredAtTemplate": "<aws.scheduler.scheduled-time>"
      }
    }
  },
