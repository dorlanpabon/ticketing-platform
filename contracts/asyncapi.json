{
  "asyncapi": "3.0.0",
  "info": {
    "title": "Ticketing asynchronous contracts",
    "version": "1.0.0",
    "description": "Implemented contracts across the three service owners, SQS Standard and the recovery scheduler. At-least-once delivery permits duplicates and reordering; only conditional durable state transitions provide idempotent business effects. This document does not claim exactly-once delivery or hard real-time timer execution."
  },
  "defaultContentType": "application/json",
  "channels": {
    "inventory-commands": {
      "address": "inventory-commands",
      "messages": {
        "ProvisionInventory": {
          "$ref": "#/components/messages/ProvisionInventory"
        },
        "PurchaseRequested": {
          "$ref": "#/components/messages/PurchaseRequested"
        },
        "ConfirmPurchase": {
          "$ref": "#/components/messages/ConfirmPurchase"
        },
        "ComplimentaryRequested": {
          "$ref": "#/components/messages/ComplimentaryRequested"
        },
        "EventCreated": {
          "$ref": "#/components/messages/EventCreated"
        }
      },
      "description": "SQS Standard. Outbox commit before publish. Delete only after durable handling; DLQ after 5 receives. Versioned snapshots never apply older state. Addresses are logical names; AWS adds the Terraform environment prefix. Queue redrive uses a separate DLQ after five receives; preserve application message IDs during manual redrive.",
      "servers": [
        {
          "$ref": "#/servers/local"
        },
        {
          "$ref": "#/servers/aws"
        }
      ],
      "x-queue-url-environment": "INVENTORY_COMMANDS_QUEUE_URL",
      "x-delivery": {
        "kind": "SQS Standard",
        "atLeastOnce": true,
        "orderingGuaranteed": false,
        "longPollSeconds": 20,
        "visibilityTimeoutSeconds": 60,
        "maxReceiveCount": 5,
        "messageRetentionSeconds": 345600,
        "deadLetterRetentionSeconds": 1209600,
        "maxMessageBytes": 262144,
        "deadLetterQueue": "inventory-commands-dlq"
      }
    },
    "order-events": {
      "address": "order-events",
      "messages": {
        "ReservationStateChanged": {
          "$ref": "#/components/messages/ReservationStateChanged"
        }
      },
      "description": "SQS Standard. Outbox commit before publish. Delete only after durable handling; DLQ after 5 receives. Versioned snapshots never apply older state. Addresses are logical names; AWS adds the Terraform environment prefix. Queue redrive uses a separate DLQ after five receives; preserve application message IDs during manual redrive.",
      "servers": [
        {
          "$ref": "#/servers/local"
        },
        {
          "$ref": "#/servers/aws"
        }
      ],
      "x-queue-url-environment": "ORDER_EVENTS_QUEUE_URL",
      "x-delivery": {
        "kind": "SQS Standard",
        "atLeastOnce": true,
        "orderingGuaranteed": false,
        "longPollSeconds": 20,
        "visibilityTimeoutSeconds": 60,
        "maxReceiveCount": 5,
        "messageRetentionSeconds": 345600,
        "deadLetterRetentionSeconds": 1209600,
        "maxMessageBytes": 262144,
        "deadLetterQueue": "order-events-dlq"
      }
    },
    "catalog-events": {
      "address": "catalog-events",
      "messages": {
        "InventoryReady": {
          "$ref": "#/components/messages/InventoryReady"
        }
      },
      "description": "SQS Standard. Outbox commit before publish. Delete only after durable handling; DLQ after 5 receives. Versioned snapshots never apply older state. Addresses are logical names; AWS adds the Terraform environment prefix. Queue redrive uses a separate DLQ after five receives; preserve application message IDs during manual redrive.",
      "servers": [
        {
          "$ref": "#/servers/local"
        },
        {
          "$ref": "#/servers/aws"
        }
      ],
      "x-queue-url-environment": "CATALOG_EVENTS_QUEUE_URL",
      "x-delivery": {
        "kind": "SQS Standard",
        "atLeastOnce": true,
        "orderingGuaranteed": false,
        "longPollSeconds": 20,
        "visibilityTimeoutSeconds": 60,
        "maxReceiveCount": 5,
        "messageRetentionSeconds": 345600,
        "deadLetterRetentionSeconds": 1209600,
        "maxMessageBytes": 262144,
        "deadLetterQueue": "catalog-events-dlq"
      }
    },
    "inventory-expirations": {
      "address": "inventory-expirations",
      "messages": {
        "ExpireReservation": {
          "$ref": "#/components/messages/ExpireReservation"
        },
        "SweepExpiredReservations": {
          "$ref": "#/components/messages/SweepExpiredReservations"
        }
      },
      "description": "Dedicated timer and recovery queue, consumed independently from purchase/provisioning commands with bounded concurrency. Physical delivery may be late under outage/backlog; persisted deadline validation and lazy whole-reservation reclamation remain authoritative. Addresses are logical names; AWS adds the Terraform environment prefix. Queue redrive uses a separate DLQ after five receives; preserve application message IDs during manual redrive.",
      "servers": [
        {
          "$ref": "#/servers/local"
        },
        {
          "$ref": "#/servers/aws"
        }
      ],
      "x-queue-url-environment": "INVENTORY_EXPIRATIONS_QUEUE_URL",
      "x-delivery": {
        "kind": "SQS Standard",
        "atLeastOnce": true,
        "orderingGuaranteed": false,
        "longPollSeconds": 20,
        "visibilityTimeoutSeconds": 60,
        "maxReceiveCount": 5,
        "messageRetentionSeconds": 345600,
        "deadLetterRetentionSeconds": 1209600,
        "maxMessageBytes": 262144,
        "deadLetterQueue": "inventory-expirations-dlq"
      }
    }
