    "receive-inventory-expirations": {
      "action": "receive",
      "channel": {
        "$ref": "#/channels/inventory-expirations"
      },
      "summary": "Inventory timer consumer; application idempotency and durable ACK boundaries apply"
    },
    "catalog-provision-inventory": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inventory-commands"
      },
      "messages": [
        {
          "$ref": "#/channels/inventory-commands/messages/ProvisionInventory"
        }
      ],
      "summary": "Catalog outbox",
      "x-producer": "Catalog outbox"
    },
    "orders-request-allocation": {
      "action": "send",
      "channel": {
        "$ref": "#/channels/inventory-commands"
